    <string name="help_command_tokens_title">Command Tokens</string>

    <string name="help_strategic_title">🧠 Strategic</string>
    <string name="help_strategic_limit">No more than 2 tokens per game: 1 Procedural and 1 Logistical.</string>
    <string name="help_procedural_label">PROCEDURAL</string>
    <string name="help_if_first">If you go first</string>
    <string name="help_if_first_title">Hold back a trooper</string>
    <string name="help_if_first_desc">Spend 1 token during deployment: hold back a trooper (and their peripherals) and deploy them after the opponent\'s army.</string>
    <string name="help_if_second">If you go second</string>
    <string name="help_second_remove_title">−2 Regular Orders</string>
    <string name="help_second_remove_desc">Remove 2 Regular Orders from the opponent\'s order pool for this turn (only if they have more than 10 orders).</string>
    <string name="help_second_limit_title">Limit enemy tokens</string>
    <string name="help_second_limit_desc">The opponent may use no more than 1 command token during their first turn.</string>
    <string name="help_second_suppressive_title">Suppressive Fire</string>
    <string name="help_second_suppressive_desc">Allow one of your troopers to activate Suppressive Fire.</string>
    <string name="help_logistical_title">Logistical</string>
    <string name="help_logistical_desc">After both armies are deployed, gain 2 Speedball tokens.</string>

    <string name="help_operational_title">🎯 Operational</string>
    <string name="help_operational_note">During your active turn: 1 token = 1 effect, no limit.</string>
    <string name="help_coordinated_title">Coordinated Order</string>
    <string name="help_coordinated_desc">Declare a coordinated order by spending 1 Regular Order from the participating combat group\'s pool.</string>
    <string name="help_guts_title">Guts Roll control</string>
    <string name="help_guts_desc">Automatically pass or fail a Guts Roll, ignoring the die and the trooper\'s skills.</string>
    <string name="help_convert_title">Order conversion</string>
    <string name="help_convert_desc">Convert 1 Irregular Order into a Regular Order for this turn.</string>
    <string name="help_retreat_title">Retreat! immunity</string>
    <string name="help_retreat_desc">One trooper ignores the effects of Retreat! until the end of the game.</string>
    <string name="help_doctor_title">WIP reroll: Doctor</string>
    <string name="help_doctor_desc">Reroll a failed WIP roll for a trooper with Cube; the enemy does not get a new ARO.</string>
    <string name="help_engineer_title">WIP reroll: Engineer</string>
    <string name="help_engineer_desc">Reroll a failed WIP roll for a trooper with Remote Presence.</string>
    <string name="help_fireteam_title">Create a fireteam</string>
    <string name="help_fireteam_desc">Create a fireteam by placing the leader token next to a suitable trooper.</string>

    <string name="help_executive_title">🛠️ Executive</string>
    <string name="help_executive_note">During the corresponding phase of your tactical turn.</string>
    <string name="help_regroup_title">Regrouping</string>
    <string name="help_regroup_desc">Permanently move a trooper (and their peripherals) to another combat group — up to 10 members.</string>
    <string name="help_possessed_title">Remove Possession</string>
    <string name="help_possessed_desc">Cancel the Possessed state on a friendly trooper.</string>

    <!-- Speedball -->
    <string name="help_speedball_title">Speedball</string>
    <string name="help_speedball_note">Combat Jump (PH 14)</string>
    <string name="help_first_token_title">First token</string>
    <string name="help_first_token_desc">The player chooses an item from the table</string>
    <string name="help_second_token_title">Second token</string>
    <string name="help_second_token_desc">The player rolls d20 and checks the table</string>
    <string name="help_vitapack_title">VitaPack</string>
    <string name="help_vitapack_desc">Cancels Unconscious on an ally with Vitality, removing 1 wound (Short Skill in silhouette contact).</string>
    <string name="help_autorepair_title">AutoRepairS</string>
    <string name="help_autorepair_desc">Cancels Unconscious on an ally with STR, removing 1–2 wounds (Short Skill in silhouette contact).</string>
    <string name="help_switch_on_title">Switch On</string>
    <string name="help_switch_on_desc">Removes Immobilized A/B, Isolated, or Stunned from an ally (Short Skill in silhouette contact).</string>
    <string name="help_jetpack_title">Jetpack (S:2)</string>
    <string name="help_jetpack_desc">Once per order, the bearer may use Super-Jump (Jet Propulsion). Silhouette 2 only.</string>
    <string name="help_overkill_title">Overkill</string>
    <string name="help_overkill_desc">Choose: remove Unloaded and restore all Disposable consumables, or gain BS Attack (SR-1) for one order.</string>
    <string name="help_nanoshield_title">NanoShield</string>
    <string name="help_nanoshield_desc">+2 MOD to all Saving Rolls in the Resolution step of the current order.</string>
    <string name="help_speedball_restrictions">Items are single-use and non-transferable. A trooper cannot have more than one Speedball item at a time.</string>

